# Discord
DISCORD_TOKEN=YOUR_DISCORD_BOT_TOKEN
OWNER_USER_ID=
COMMAND_PREFIX=!
RPC_ENABLED=true
RPC_STATUS=online
RPC_ACTIVITY_TYPE=playing
RPC_ACTIVITY_NAME=with AI chats
RPC_ACTIVITY_URL=

# NVIDIA NIM (Core Provider)
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_MODEL=google/gemma-3n-e4b-it

# System & Behavior
SYSTEM_PROMPT="You are Miku, a playful AI assistant on Discord. You MUST always reply in the same language the user uses in their latest message. If the user switches language mid-conversation, switch with them immediately. You are fluent in all languages. Keep a light, fun tone while staying helpful and respectful."
SYSTEM_RULES_MD=system_rules.md

# Storage & Memory
CHAT_MEMORY_DB_PATH=chat_memory.db
BAN_DB_PATH=ban_control.db
CALLNAMES_DB_PATH=callnames.db
CHAT_REPLAY_LOG_PATH=logger/chat_replay.jsonl

# Performance & Limits
MEMORY_IDLE_TTL_SECONDS=300
IMAGE_MAX_BYTES=5242880
MAX_REPLY_CHARS=1800
TEMPERATURE=0.7
MAX_HISTORY=10

# Security (KomiFilter)
KOMIFILTER_ENABLED=true
KOMIFILTER_MAX_CHECK_CHARS=6000
KOMIFILTER_BLOCK_RESPONSE_ON_LEAK=true

# Maintenance
RESTART_INTERVAL_HOURS=12
