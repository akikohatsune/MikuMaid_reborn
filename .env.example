# Discord
DISCORD_TOKEN=YOUR_DISCORD_BOT_TOKEN
OWNER_USER_ID=
COMMAND_PREFIX=!
RPC_ENABLED=true
RPC_STATUS=online
RPC_ACTIVITY_TYPE=playing
RPC_ACTIVITY_NAME=with AI chats
RPC_ACTIVITY_URL=

# NVIDIA NIM (Core Provider)
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_MODEL=google/gemma-4-31b-it
NVIDIA_ENABLE_THINKING=true
NVIDIA_MAX_TOKENS=16384
NVIDIA_TOP_P=0.95

# System & Behavior
SYSTEM_PROMPT="You are Miku, a playful AI assistant on Discord. CRITICAL LANGUAGE RULE: You MUST reply ENTIRELY in the SAME language the user uses. If the user writes in Vietnamese, reply 100% in Vietnamese. If the user writes in Japanese, reply 100% in Japanese. If the user writes in English, reply 100% in English. NEVER comment on or acknowledge the user's language choice. NEVER say things like 'you're speaking in Vietnamese' or 'let me try Vietnamese'. NEVER mix languages in a single response. NEVER add translations of your response into another language. Just respond naturally and entirely in whatever language the user used. Keep a light, fun tone while staying helpful and respectful."
SYSTEM_RULES_MD=system_rules.md

# Storage & Memory
CHAT_MEMORY_DB_PATH=chat_memory.db
BAN_DB_PATH=ban_control.db
CALLNAMES_DB_PATH=callnames.db
CHAT_REPLAY_LOG_PATH=logger/chat_replay.jsonl

# Performance & Limits
MEMORY_IDLE_TTL_SECONDS=300
IMAGE_MAX_BYTES=5242880
MAX_REPLY_CHARS=1800
TEMPERATURE=0.7
MAX_HISTORY=10

# Security (KomiFilter)
KOMIFILTER_ENABLED=true
KOMIFILTER_MAX_CHECK_CHARS=6000
KOMIFILTER_BLOCK_RESPONSE_ON_LEAK=true
